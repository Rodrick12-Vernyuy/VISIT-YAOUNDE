NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/visit_yaounde

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Leave empty to run with local email/password auth only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Leave empty to store uploaded images on local disk (backend/uploads) instead of Cloudinary.
CLOUDINARY_URL=

UPLOAD_DIR=uploads

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

SEED_ADMIN_EMAIL=admin@visityaounde.cm
SEED_ADMIN_PASSWORD=ChangeMe123!

// Generates into .prisma/client (Prisma's recommended location) rather than
// overwriting @prisma/client directly — newer Prisma CLI versions refuse to
// generate into a pristine npm-installed @prisma/client package. App code
// imports the client via src/config/prisma.ts (a relative import, not the
// bare '@prisma/client' specifier) since npm workspace hoisting means the
// bare specifier can resolve to a different service's generated client.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["itinerary"]
}

model Itinerary {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // References User (auth-service) by id only — no cross-service foreign
  // keys, standard microservices practice.
  userId String

  items ItineraryItem[]

  @@index([userId])
  @@schema("itinerary")
  @@map("itineraries")
}

model ItineraryItem {
  id        String   @id @default(uuid())
  dayNumber Int
  order     Int
  notes     String?
  createdAt DateTime @default(now())

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  // References Attraction (attractions-service) by id only.
  attractionId String

  @@index([itineraryId])
  @@schema("itinerary")
  @@map("itinerary_items")
}

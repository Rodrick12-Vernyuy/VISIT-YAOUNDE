// Generates into .prisma/client (Prisma's recommended location) rather than
// overwriting @prisma/client directly — newer Prisma CLI versions refuse to
// generate into a pristine npm-installed @prisma/client package. App code
// imports the client via src/config/prisma.ts (a relative import, not the
// bare '@prisma/client' specifier) since npm workspace hoisting means the
// bare specifier can resolve to a different service's generated client.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["engagement"]
}

model Review {
  id           String   @id @default(uuid())
  rating       Int
  comment      String
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // References User (auth-service) and Attraction (attractions-service) by id only —
  // no cross-service foreign keys, standard microservices practice.
  userId       String
  attractionId String

  helpfulVotes ReviewHelpful[]

  @@unique([userId, attractionId])
  @@index([attractionId])
  @@schema("engagement")
  @@map("reviews")
}

model ReviewHelpful {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([reviewId, userId])
  @@schema("engagement")
  @@map("review_helpfuls")
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId       String
  attractionId String

  @@unique([userId, attractionId])
  @@index([userId])
  @@schema("engagement")
  @@map("favorites")
}

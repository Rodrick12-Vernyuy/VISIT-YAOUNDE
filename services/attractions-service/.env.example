NODE_ENV=development
PORT=4002
GATEWAY_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/visit_yaounde?schema=attractions

JWT_ACCESS_SECRET=change-me-access-secret

# Leave empty to store uploaded images on local disk (uploads/) instead of Cloudinary.
CLOUDINARY_URL=
UPLOAD_DIR=uploads

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Shared secret the engagement-service presents to call /internal/* routes.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

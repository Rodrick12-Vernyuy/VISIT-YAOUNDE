// Generates into .prisma/client (Prisma's recommended location) rather than
// overwriting @prisma/client directly — newer Prisma CLI versions refuse to
// generate into a pristine npm-installed @prisma/client package. App code
// imports the client via src/config/prisma.ts (a relative import, not the
// bare '@prisma/client' specifier) since npm workspace hoisting means the
// bare specifier can resolve to a different service's generated client.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["notification"]
}

enum NotificationType {
  WELCOME
  NEW_REVIEW
  SYSTEM

  @@schema("notification")
}

model Notification {
  id        String            @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  // References User (auth-service) by id only — no cross-service foreign
  // keys, standard microservices practice.
  userId String

  @@index([userId, read])
  @@schema("notification")
  @@map("notifications")
}

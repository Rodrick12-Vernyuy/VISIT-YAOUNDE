// Generates into .prisma/client (Prisma's recommended location) rather than
// overwriting @prisma/client directly — newer Prisma CLI versions refuse to
// generate into a pristine npm-installed @prisma/client package. App code
// imports the client via src/config/prisma.ts (a relative import, not the
// bare '@prisma/client' specifier) since npm workspace hoisting means the
// bare specifier can resolve to a different service's generated client.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["booking"]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@schema("booking")
}

model Booking {
  id             String        @id @default(uuid())
  visitDate      DateTime
  numberOfPeople Int
  status         BookingStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // References User (auth-service) and Attraction (attractions-service) by id
  // only — no cross-service foreign keys, standard microservices practice.
  userId       String
  attractionId String

  @@index([userId])
  @@index([attractionId])
  @@schema("booking")
  @@map("bookings")
}
